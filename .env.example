ANTHROPIC_API_KEY=

# Optional — cloud sync (see supabase/schema.sql for setup). Leave both
# blank and the app runs exactly as before: fully local, guest-friendly,
# no account needed. Create a free project at supabase.com, run
# supabase/schema.sql in its SQL Editor, then paste the Project URL and
# anon public key from Settings → API here to turn on real accounts +
# cross-device sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
